{
  "name": "motion-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MOTION LAB — Form Shooting: video-only basketball shooting form research tool (PWA)",
  "scripts": {
    "postinstall": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "idb": "^8.0.3",
    "js-yaml": "^5.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
